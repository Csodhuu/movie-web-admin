# Энэ файлыг .env.local нэрээр хуулж, жинхэнэ утгуудаа бичнэ үү.
# Энд жинхэнэ нууц үг бүү бичээрэй: энэ файл git-д орно.

# MongoDB холболт (MongoDB Atlas эсвэл локал)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/movie-admin?retryWrites=true&w=majority

# `npm run seed` ажиллуулахад үүсэх эхний Super Admin
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
